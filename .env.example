# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=replace_with_your_openai_project_key
OPENAI_MODEL=gpt-4.1-mini
# Use a private password to unlock the chatbot.
CHAT_ACCESS_PASSWORD=replace_with_a_long_private_password
# Generate a long random value; this signs login cookies.
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
